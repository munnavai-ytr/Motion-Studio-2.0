# Motion Studio Environment Configuration
# Architecture: Bring Your Own Key (BYOK)
# Each user provides their own Gemini API key in the app interface.
# Keys are encrypted locally in IndexedDB and sent only to Google via the app's secure API routes.
# No server-side fallback key is required or used.

# APP_URL: The URL where this app is hosted.
# AI Studio automatically injects this at runtime with the service URL.
APP_URL="MY_APP_URL"
